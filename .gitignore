# Assistant working files (never committed)
CLAUDE.md
CHECKLIST.md
.claude/
.build/

# Data: the MoleculeNet download and any derived arrays are never committed
data/
*.csv

# Exception: the notebook's own result tables. These are the numbers the report quotes,
# not dataset records, and report/make_tables.py reads them to build the LaTeX tables.
!outputs/tables/*.csv

# Environments and caches
.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store

# Figure previews / audit records (the PDFs used by the report are regenerated by the notebook)
figures/_preview/
figures/_audit/

# LaTeX build products (the submitted PDF is uploaded to Moodle separately)
report/*.pdf
report/*.log
report/*.aux
report/*.out
